# 複製成 .env 後修改：  cp .env.example .env
# 密碼請避免使用 $ # " ' 等特殊字元（Compose 會解讀它們）
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=terminal_report
DB_USER=terminal
DB_PASSWORD=change_me

# 網頁「SQL 查詢」使用的唯讀帳號（強烈建議設定；留空則改用上面的主要帳號）
DB_RO_USER=terminal_ro
DB_RO_PASSWORD=change_me_ro

# 每次匯出入庫前是否先清空三張匯出資料表的舊資料（true／false）；false 則保留每次匯出的歷史批次
EXPORT_CLEAR_BEFORE_SAVE=true
